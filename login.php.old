<?php
require_once __DIR__ . '/includes/auth.php';

$pdo = authBootstrap();
$error = '';
$next = $_GET['next'] ?? 'index.php';

if (preg_match('/^https?:\/\//i', $next) || substr($next, 0, 2) === '//') {
    $next = 'index.php';
}

if (is_logged_in()) {
    header('Location: index.php');
    exit;
}

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $username = trim($_POST['username'] ?? '');
    $password = $_POST['password'] ?? '';
    $next = $_POST['next'] ?? 'index.php';

    if (preg_match('/^https?:\/\//i', $next) || substr($next, 0, 2) === '//') {
        $next = 'index.php';
    }

    $stmt = $pdo->prepare("SELECT * FROM users WHERE username = ? AND is_active = 1 LIMIT 1");
    $stmt->execute([$username]);
    $user = $stmt->fetch();

    if ($user && password_verify($password, $user['password_hash'])) {
        login_user($user);
        header('Location: ' . ($next ?: 'index.php'));
        exit;
    }

    $error = 'Invalid username or password.';
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>TalaKlase - Login</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css"/>
  <link rel="stylesheet" href="assets/css/style.css"/>
</head>
<body class="login-page">
  <main class="login-shell">
    <section class="login-panel">
      <div class="login-brand">
        <div class="logo-icon"><i class="bi bi-mortarboard-fill"></i></div>
        <div>
          <h1>TalaKlase</h1>
          <p>Your Records, Your Way</p>
        </div>
      </div>

      <?php if ($error): ?>
        <div class="alert alert-danger py-2"><?= htmlspecialchars($error) ?></div>
      <?php endif; ?>

      <form method="POST" autocomplete="off">
        <input type="hidden" name="next" value="<?= htmlspecialchars($next) ?>"/>
        <div class="mb-3">
          <label class="form-label" for="username">Username</label>
          <input class="form-control" id="username" name="username" required autofocus/>
        </div>
        <div class="mb-3">
          <label class="form-label" for="password">Password</label>
          <input class="form-control" id="password" name="password" type="password" required/>
        </div>
        <button class="btn btn-primary w-100" type="submit">
          <i class="bi bi-box-arrow-in-right me-1"></i> Login
        </button>
      </form>

      <div class="login-note">
        First admin account: <strong>admin</strong> / <strong>admin123</strong>. Change this password before real use.
      </div>
    </section>
  </main>
</body>
</html>
