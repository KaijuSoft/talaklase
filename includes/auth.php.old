<?php
// TalaKlase authentication and role-based access control helpers.

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

require_once __DIR__ . '/db.php';

const DEFAULT_ADMIN_USERNAME = 'admin';
const DEFAULT_ADMIN_PASSWORD = 'admin123';

function ensureUsersTable(PDO $pdo): void {
    $pdo->exec("
        CREATE TABLE IF NOT EXISTS users (
            id INT AUTO_INCREMENT PRIMARY KEY,
            name VARCHAR(100) NOT NULL,
            username VARCHAR(50) NOT NULL UNIQUE,
            password_hash VARCHAR(255) NOT NULL,
            role VARCHAR(20) NOT NULL DEFAULT 'viewer',
            is_active TINYINT(1) NOT NULL DEFAULT 1,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4
    ");

    $count = (int)$pdo->query("SELECT COUNT(*) FROM users")->fetchColumn();
    if ($count === 0) {
        $stmt = $pdo->prepare("INSERT INTO users (name, username, password_hash, role) VALUES (?, ?, ?, ?)");
        $stmt->execute([
            'Administrator',
            DEFAULT_ADMIN_USERNAME,
            password_hash(DEFAULT_ADMIN_PASSWORD, PASSWORD_DEFAULT),
            'admin'
        ]);
    }
}

function authBootstrap(): PDO {
    $pdo = getConnection();
    ensureUsersTable($pdo);
    return $pdo;
}

function current_user(): ?array {
    return $_SESSION['user'] ?? null;
}

function is_logged_in(): bool {
    return current_user() !== null;
}

function login_user(array $user): void {
    session_regenerate_id(true);
    $_SESSION['user'] = [
        'id' => (int)$user['id'],
        'name' => $user['name'],
        'username' => $user['username'],
        'role' => $user['role'],
    ];
}

function logout_user(): void {
    $_SESSION = [];
    if (ini_get('session.use_cookies')) {
        $params = session_get_cookie_params();
        setcookie(session_name(), '', time() - 42000, $params['path'], $params['domain'], $params['secure'], $params['httponly']);
    }
    session_destroy();
}

function permissions_for_role(string $role): array {
    $permissions = [
        'admin' => [
            'view_students', 'manage_students',
            'view_attendance', 'manage_attendance',
            'view_grades', 'manage_grades', 'manage_score_settings',
            'manage_reference_data', 'manage_sync', 'manage_updates',
            'print_reports',
        ],
        'instructor' => [
            'view_students',
            'view_attendance', 'manage_attendance',
            'view_grades', 'manage_grades',
            'print_reports',
        ],
        'viewer' => [
            'view_students',
            'view_attendance',
            'view_grades',
            'print_reports',
        ],
    ];

    return $permissions[$role] ?? [];
}

function can(string $permission): bool {
    $user = current_user();
    if (!$user) {
        return false;
    }
    return in_array($permission, permissions_for_role($user['role']), true);
}

function wants_json_response(): bool {
    $accept = $_SERVER['HTTP_ACCEPT'] ?? '';
    $requestedWith = $_SERVER['HTTP_X_REQUESTED_WITH'] ?? '';
    return $_SERVER['REQUEST_METHOD'] === 'POST'
        || stripos($accept, 'application/json') !== false
        || strtolower($requestedWith) === 'xmlhttprequest';
}

function send_no_cache_headers(): void {
    if (headers_sent()) {
        return;
    }

    header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
    header('Pragma: no-cache');
    header('Expires: 0');
}

function deny_access(string $message = 'You do not have permission to perform this action.'): void {
    if (wants_json_response()) {
        http_response_code(403);
        header('Content-Type: application/json');
        echo json_encode(['success' => false, 'message' => $message]);
        exit;
    }

    http_response_code(403);
    echo '<div class="alert alert-danger m-3">' . htmlspecialchars($message) . '</div>';
    exit;
}

function require_login(): void {
    if (is_logged_in()) {
        send_no_cache_headers();
        return;
    }

    if (wants_json_response()) {
        http_response_code(401);
        header('Content-Type: application/json');
        echo json_encode(['success' => false, 'message' => 'Please log in to continue.']);
        exit;
    }

    $target = $_SERVER['REQUEST_URI'] ?? 'index.php';
    header('Location: login.php?next=' . urlencode($target));
    exit;
}

function require_permission(string $permission): void {
    require_login();
    if (!can($permission)) {
        deny_access();
    }
}

function page_permission(string $page): ?string {
    $map = [
        'students' => 'view_students',
        'attendance' => 'manage_attendance',
        'view_attendance' => 'view_attendance',
        'print_attendance' => 'view_attendance',
        'grades' => 'view_grades',
        'score_settings' => 'manage_score_settings',
        'courses' => 'manage_reference_data',
        'departments' => 'manage_reference_data',
        'instructors' => 'manage_reference_data',
        'sections' => 'manage_reference_data',
        'subjects' => 'manage_reference_data',
        'sync' => 'manage_sync',
    ];

    return $map[$page] ?? null;
}

function first_allowed_page(): string {
    foreach (['students', 'attendance', 'view_attendance', 'grades', 'departments'] as $page) {
        $permission = page_permission($page);
        if ($permission && can($permission)) {
            return $page;
        }
    }

    return 'students';
}
